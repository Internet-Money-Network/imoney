# systemd unit for an Internet Money node.
#   sudo useradd --system --create-home --home-dir /var/lib/imoney imoney
#   sudo cp target/release/imoney-node /usr/local/bin/
#   sudo cp deploy/imoney-node.service /etc/systemd/system/
#   sudo systemctl enable --now imoney-node
[Unit]
Description=Internet Money node
After=network-online.target
Wants=network-online.target

[Service]
User=imoney
ExecStart=/usr/local/bin/imoney-node \
    --data-dir /var/lib/imoney \
    --p2p-bind 0.0.0.0:18555 \
    --rpc-bind 127.0.0.1:18556 \
    --peers seed.internetmoneynetwork.org:18555
Restart=on-failure
RestartSec=5
# The node saves its peer list on SIGINT
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/imoney
PrivateTmp=true

[Install]
WantedBy=multi-user.target
