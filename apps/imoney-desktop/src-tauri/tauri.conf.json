{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Internet Money",
  "version": "0.1.9",
  "identifier": "org.internetmoneynetwork.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Internet Money",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/imoney-node"],
    "shortDescription": "Spend, save and build on Internet Money",
    "longDescription": "The Internet Money wallet in its own window, with a node built in so it checks payments itself.",
    "category": "Finance",
    "copyright": "Internet Money Developers"
  }
}
